apiVersion: v1
kind: Secret
metadata:
  name: outreach-secrets
  namespace: deps-lead-svc
type: Opaque
stringData:
  # Database Credentials
  # IMPORTANT: Replace these with your actual credentials
  DB_USER: "postgres"
  DB_PASSWORD: "postgres"
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "postgres"
  SPRING_DATASOURCE_USERNAME: "postgres"
  SPRING_DATASOURCE_PASSWORD: "postgres"
  
  # RabbitMQ Credentials
  RABBITMQ_USER: "guest"
  RABBITMQ_PASSWORD: "guest"
  RABBITMQ_DEFAULT_USER: "guest"
  RABBITMQ_DEFAULT_PASS: "guest"
  
  # JWT Secret (MUST be at least 64 characters for HS512)
  JWT_SECRET: "change-this-secret-in-production-must-be-at-least-64-characters-long-for-hs512"
  
  # Email Credentials
  # IMPORTANT: Replace with your actual email credentials
  MAIL_USERNAME: "your-email@gmail.com"
  MAIL_PASSWORD: "your-app-password-here"
  
  # AI API Keys
  # IMPORTANT: Replace with your actual API keys
  OPENAI_API_KEY: "your-openai-api-key-here"
  GEMINI_API_KEY: "your-gemini-api-key-here"

---
# INSTRUCTIONS FOR PRODUCTION USE:
# ================================================================================
# 
# ⚠️  DO NOT COMMIT THIS FILE WITH REAL SECRETS TO GIT! ⚠️
#
# This is an EXAMPLE file showing the structure. To use it:
#
# 1. Copy this file:
#    cp secrets.yaml.example secrets.yaml
#
# 2. Edit secrets.yaml with your real credentials:
#    vim secrets.yaml  # or your preferred editor
#
# 3. Apply to your cluster:
#    kubectl apply -f secrets.yaml
#
# 4. Add secrets.yaml to .gitignore to prevent accidental commits:
#    echo "infra/k8s/secrets.yaml" >> .gitignore
#
# ALTERNATIVE: Create secrets directly with kubectl (recommended for production):
#
#   kubectl create secret generic outreach-secrets \
#     --namespace=deps-lead-svc \
#     --from-literal=DB_USER=postgres \
#     --from-literal=DB_PASSWORD=your-secure-password \
#     --from-literal=JWT_SECRET=your-jwt-secret \
#     --from-literal=OPENAI_API_KEY=your-openai-key \
#     --from-literal=GEMINI_API_KEY=your-gemini-key \
#     --from-literal=MAIL_USERNAME=your-email@gmail.com \
#     --from-literal=MAIL_PASSWORD=your-app-password
#
# BEST PRACTICE: Use external secret management for production:
# - Google Secret Manager (GKE)
# - HashiCorp Vault
# - AWS Secrets Manager
# - Azure Key Vault
#
# ================================================================================
